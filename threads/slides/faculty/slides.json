  "slide": 24,
  "texts": [
   "On-site interviews",
   "Job talk",
   "Several 1-on-1 interviews",
   "Faculty members",
   "Department head",
   "Dean",
   "Students",
   "Staff",
   "Nice breakfast/lunch/dinner with faculty members",
   "JUST FINISHED AN ",
   "ON-SITE INTERVIEW"
  ],
